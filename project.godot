; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Valewright"
config/version="0.0.0.4.20"
config/description="Baue. Wirtschafte. Herrsche. – ein Aufbauspiel von Odenforge"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

I18n="*res://scripts/i18n.gd"
Session="*res://scripts/session.gd"

[display]

mouse_cursor/tooltip_position_offset=Vector2(12, 58)

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2

[shader_globals]

fog_tex={
"type": "sampler2D",
"value": ""
}
fog_size={
"type": "float",
"value": 360.0
}
